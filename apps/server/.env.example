# 서버 포트
PORT=3000

# 개인 카카오 관련 키 (실제 값은 .env 에만, 커밋 금지)
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=

# A2A 서버 — 'RAG 검색'이 대화 이력을 보내 답변받는 외부 에이전트(SSE 스트리밍)
# 기본값은 google-adk RAG 에이전트(JSON-RPC). 아래는 두 가지 예시.
#  (a) Google ADK (JSON-RPC message/stream):
A2A_ENDPOINT=http://16.16.208.36:8000/a2a/google-adk-agent/jsonrpc
A2A_PROTOCOL=jsonrpc
#  (b) REST 스타일(예: llamon) — body {message}, Bearer 인증. 전환 시:
#      A2A_ENDPOINT=https://<host>/api/registry-playground/a2a/<agentId>/message
#      A2A_PROTOCOL=rest
#      A2A_AUTH=Bearer <JWT 토큰>   ← 비밀. .env 에만, 커밋 금지
A2A_AUTH=
# 오프라인/로컬 개발용 MSW 목업 켜기(1). 기본 off(실서버 사용).
A2A_MOCK=0
# 목업 SSE 지속(ms) — A2A_MOCK=1 일 때만. 콜백 없이 데모하려면 3000 이하로.
A2A_DURATION_MS=30000
# A2A 스트림 대기 상한(ms). 콜백 유효(1분)보다 짧게.
A2A_TIMEOUT_MS=55000
# 콜백 미설정 시 동기 시도 예산(ms). 카카오 5초 제한보다 짧게(1001 방지).
SYNC_BUDGET_MS=3500
