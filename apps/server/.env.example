# 서버 포트
PORT=3000

# 개인 카카오 관련 키 (실제 값은 .env 에만, 커밋 금지)
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=

# A2A 에이전트 — 'RAG 검색'이 대화 이력을 보내 답변받는 외부 에이전트(SSE 스트리밍)
# ⚠️ 임시 테스트/목업: 기본 엔드포인트·프로토콜은 config.ts 에 고정(현재 llamon 데모 에이전트).
#    추후 실제 RAG 백엔드로 교체 시 아래 3개만 바꾸면 됨(코드 변경 불필요).
# A2A_ENDPOINT=<엔드포인트>      # 미설정 시 config.ts 기본값(llamon) 사용
# A2A_PROTOCOL=rest             # rest(llamon 등) | jsonrpc(Google ADK)
# 비밀 토큰(Bearer). 현재 llamon JWT는 만료 있음 — 만료 시 이 값만 교체. 절대 커밋 금지.
A2A_AUTH=Bearer <JWT 토큰>
# 오프라인/로컬 개발용 MSW 목업 켜기(1). 기본 off(실서버 사용).
A2A_MOCK=0
# 목업 SSE 지속(ms) — A2A_MOCK=1 일 때만. 콜백 없이 데모하려면 3000 이하로.
A2A_DURATION_MS=30000
# A2A 스트림 대기 상한(ms). 콜백 유효(1분)보다 짧게.
A2A_TIMEOUT_MS=55000
# 콜백 미설정 시 동기 시도 예산(ms). 카카오 5초 제한보다 짧게(1001 방지).
SYNC_BUDGET_MS=3500
